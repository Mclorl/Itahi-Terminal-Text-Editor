Checks: >
  -*,bugprone-*,-bugprone-easily-swappable-parameters,
  clang-analyzer-*,performance-*,misc-unused-parameters,
  readability-container-size-empty,readability-simplify-boolean-expr,
  readability-function-cognitive-complexity,cppcoreguidelines-init-variables
CheckOptions:
  - {key: readability-function-cognitive-complexity.Threshold, value: 25}
HeaderFilterRegex: 'src/.*'
